local CARPET_NAMES = {"Flying Carpet","Carpet","Cloud","Witch's Broom","Cupid's Wings","Santa's Sleigh","Magic Carpet","Waverider"}
local function findTool(name)
    local c = player.Character
    local bp = player:FindFirstChild("Backpack")
    return (c and c:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
end
local function equipCarpet()
    local c = player.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not h then return nil end
    for _, n in ipairs(CARPET_NAMES) do
        if c:FindFirstChild(n) then return n end
    end
    for _, n in ipairs(CARPET_NAMES) do
        local t = findTool(n)
        if t and t:IsA("Tool") then
            if t.Parent~=c then pcall(function() h:EquipTool(t) end) end
            return n
        end
    end
    return nil
end
local function unequipAll()
    local c = player.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then pcall(function() h:UnequipTools() end) end
end
local function vZero(hrp)
    if hrp and hrp.Parent then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function getFloorInfo(petY, slot)
    local s = tonumber(slot)
    if s and s >= 1 and s < 11 then return 1, -4
    elseif s and s >= 19 then return 3, 21
    elseif s and s >= 11 then return 2, 14.5 end
    if petY > 23.15 then return 3, 21
    elseif petY >= 11 then return 2, 14.5
    elseif petY <= 8.9 then return 1, -4
    else return 1, petY end
end

local function carpetEngage()
    local t0 = os.clock()
    while not findTool("Grapple Hook") and os.clock()-t0<5 do RunService.Heartbeat:Wait() end
    local c = player.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not c or not h then return nil end
    if not c:FindFirstChild("Grapple Hook") then
        local g = findTool("Grapple Hook")
        if g then pcall(function() h:EquipTool(g) end) end
    end
    task.wait(0.08)
    _G.sabcomFireGrapple2()
    task.wait(0.15)
    local hh = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hh then pcall(function() hh:UnequipTools() end) end
    task.wait(0.15)
    local cn
    local tc = os.clock()
    repeat
        cn = equipCarpet()
        local cc = player.Character
        if cn and cc and cc:FindFirstChild(cn) then break end
        RunService.Heartbeat:Wait()
    until os.clock()-tc > 1.5
    return cn
end

local function doClone()
