-- Drag
do
    local dragHandle = new("Frame", {Size=UDim2.new(1,-40,1,0), BackgroundTransparency=1, Active=true, ZIndex=2}, header)
    local dragging, startInput, startPos
    local function isPtr(i)
        return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch
    end
    local function currentOffsetPos()
        local vp = getViewport()
        return Vector2.new(
            mainPanel.Position.X.Scale * vp.X + mainPanel.Position.X.Offset,
            mainPanel.Position.Y.Scale * vp.Y + mainPanel.Position.Y.Offset
        )
    end
    local function clampPos(pos)
        local vp = getViewport()
        local sz = mainPanel.AbsoluteSize
        local x = math.clamp(pos.X, 0, math.max(0, vp.X - sz.X))
        local y = math.clamp(pos.Y, 0, math.max(0, vp.Y - sz.Y))
        return UDim2.new(0, x, 0, y)
    end
    dragHandle.InputBegan:Connect(function(i)
        if not isPtr(i) then return end
        dragging = true
        startInput = i.Position
        startPos = currentOffsetPos()
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
        local d = i.Position - startInput
        mainPanel.Position = clampPos(Vector2.new(startPos.X + d.X, startPos.Y + d.Y))
    end)
    UserInputService.InputEnded:Connect(function(i)
        if isPtr(i) and dragging then
            dragging = false
            local vp = getViewport()
            local pos = mainPanel.Position
            Config.panelPosition = {
                X = 0, XOffset = pos.X.Scale * vp.X + pos.X.Offset,
                Y = 0, YOffset = pos.Y.Scale * vp.Y + pos.Y.Offset,
            }
            saveConfig()
        end
    end)
    Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        mainPanel.Position = clampPos(currentOffsetPos())
    end)
end

