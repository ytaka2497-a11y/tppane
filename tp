    }, box)
    new("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,6)}, box)

    local head = new("Frame", {
        Name="Header", Size=UDim2.new(1,0,0,18),
        BackgroundTransparency=1, LayoutOrder=1, ZIndex=21
    }, box)
    local hTitle = new("TextLabel", {
        Text=titleText, Font=FONT_BOLD, TextSize=11, TextColor3=Color3.new(1,1,1),
        TextXAlignment=Enum.TextXAlignment.Left, BackgroundTransparency=1,
        Size=UDim2.new(0.75,0,1,0), ZIndex=21
    }, head)
    titleUnderline(hTitle, 24)

    local closeBtn = new("TextButton", {
        Text="✕", Font=FONT_BOLD, TextSize=10, TextColor3=Theme.TextDim,
        AutoButtonColor=false, BackgroundColor3=Theme.PanelField,
        Size=UDim2.new(0,20,0,20), Position=UDim2.new(1,-20,0,-1), ZIndex=22
    }, head)
    corner(closeBtn, 4)
    strokeOn(closeBtn, Theme.Border, 1)
    closeBtn.MouseEnter:Connect(function() tw(closeBtn,{BackgroundColor3=Theme.PanelField2},0.12) end)
    closeBtn.MouseLeave:Connect(function() tw(closeBtn,{BackgroundColor3=Theme.PanelField},0.12)  end)

    local content, scroll
    if fixedH then
        content = new("Frame", {
            Size=UDim2.new(1,0,0,fixedH-36), BackgroundTransparency=1,
            LayoutOrder=2, ZIndex=21
        }, box)
        scroll = new("ScrollingFrame", {
            Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, BorderSizePixel=0,
            ScrollBarThickness=3, ScrollBarImageColor3=Theme.AccentB,
            CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
            Active=true
        }, content)
        new("UIPadding", {PaddingTop=UDim.new(0,2), PaddingBottom=UDim.new(0,4)}, scroll)
        new("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,3)}, scroll)
    else
        content = new("Frame", {
            Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1, LayoutOrder=2, ZIndex=21
        }, box)
    end

    local isOpen = false
    local function open()
        if isOpen then return end
        isOpen = true
        overlay.Visible = true
        box.Position = UDim2.new(0.5,0,0.5,12)
        box.BackgroundTransparency = 1
        pushBlur()
        tw(overlay, {BackgroundTransparency=0.45}, 0.22)
        tw(box, {Position=UDim2.new(0.5,0,0.5,0), BackgroundTransparency=0}, 0.22, Enum.EasingStyle.Back)
    end
    local function close()
        if not isOpen then return end
        isOpen = false
        popBlur()
        tw(overlay, {BackgroundTransparency=1}, 0.18)
        local t2 = tw(box, {Position=UDim2.new(0.5,0,0.5,12), BackgroundTransparency=1}, 0.18)
        t2.Completed:Connect(function() if not isOpen then overlay.Visible=false end end)
