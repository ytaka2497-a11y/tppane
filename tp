local function createSlider(parent, label, order, min, max, def, dec, suffix, key, liveUpdate)
    local block = new("Frame", {
        Size=UDim2.new(1,0,0,28), BackgroundTransparency=1, LayoutOrder=order
    }, parent)
    local head = new("Frame", {Size=UDim2.new(1,0,0,12), BackgroundTransparency=1}, block)
    new("TextLabel", {
        Text=label, Font=FONT_BOLD, TextSize=10, TextColor3=Theme.Text,
        TextXAlignment=Enum.TextXAlignment.Left, BackgroundTransparency=1,
        Size=UDim2.new(0.62,0,1,0)
    }, head)
    local valLbl = new("TextLabel", {
        Text=tostring(def)..(suffix or ""), Font=FONT_BOLD, TextSize=9, TextColor3=Theme.TextDim,
        TextXAlignment=Enum.TextXAlignment.Right, BackgroundTransparency=1,
        Size=UDim2.new(0.38,0,1,0), Position=UDim2.new(0.62,0,0,0)
    }, head)

    local track = new("Frame", {
        Size=UDim2.new(1,0,0,4), Position=UDim2.new(0,0,0,17),
        BackgroundColor3=Theme.PanelField2, Active=true
    }, block)
    corner(track, 3)
    local fill = new("Frame", {Size=UDim2.new(0,0,1,0), BackgroundColor3=Theme.AccentB}, track)
    corner(fill, 3)
    local knob = new("Frame", {
        Size=UDim2.new(0,12,0,12), Position=UDim2.new(0,-6,0.5,-6),
        BackgroundColor3=Color3.new(1,1,1), Active=true
    }, track)
    corner(knob, 6)
    strokeOn(knob, Theme.AccentB, 1.5)

    local dragging, cur = false, def
    local function setAlpha(a)
        a = math.clamp(a, 0, 1)
        local raw = min + (max-min) * a
        if dec==0 then raw = math.floor(raw+0.5)
        else raw = math.floor(raw*10^dec+0.5)/10^dec end
        fill.Size = UDim2.new(a,0,1,0)
        knob.Position = UDim2.new(a,-6,0.5,-6)
        valLbl.Text = (dec==0 and tostring(raw) or string.format("%."..dec.."f", raw))..(suffix or "")
        cur = raw
        if liveUpdate then liveUpdate(cur) end
        return raw
    end
    setAlpha((def-min)/(max-min))

    local function update(inp)
        if not dragging then return end
        setAlpha((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging = true; update(i)
        end
    end)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            update(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if (i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) and dragging then
            dragging = false
            if key then Config[key]=cur; saveConfig() end
        end
    end)
    return {Block=block, GetValue=function() return cur end, SetValue=function(v) setAlpha((v-min)/(max-min)) end}
end

