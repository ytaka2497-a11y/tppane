-- ============================================================
local _vizFolder = nil
local function clearViz()
    if _vizFolder then pcall(function() _vizFolder:Destroy() end) end
    _vizFolder = nil
end
_G.clearViz = clearViz

local function ensureVizFolder()
    if _vizFolder and _vizFolder.Parent then return end
    _vizFolder = Instance.new("Folder")
    _vizFolder.Name = "TPPanelRouteViz"
    _vizFolder.Parent = Workspace
end

local function vizLine(a, b, color)
    if (b - a).Magnitude < 0.05 then return end
    ensureVizFolder()
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = color
    p.Size = Vector3.new(0.6, 0.6, (b - a).Magnitude)
    p.CFrame = CFrame.lookAt((a + b) * 0.5, b)
    p.Parent = _vizFolder
end

local function vizDot(pos, color, sz)
    ensureVizFolder()
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = color
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(sz, sz, sz)
    p.CFrame = CFrame.new(pos)
    p.Parent = _vizFolder
end

local function vizPath(fromPos, waypoints)
    if not waypoints or #waypoints == 0 then return end
    local CYAN   = Color3.fromRGB(90, 255, 235)
    local YELLOW = Color3.fromRGB(255, 220, 70)
    clearViz()
    vizDot(fromPos, YELLOW, 2.4)
    local prev = fromPos
    local n = #waypoints
    for i, wp in ipairs(waypoints) do
        vizLine(prev, wp, CYAN)
        if i < n and (wp - prev).Magnitude > 12 then
            vizDot(wp, YELLOW, 1.4)
        end
        prev = wp
    end
    vizDot(waypoints[n], YELLOW, 2.6)
end
_G.vizPath = vizPath

