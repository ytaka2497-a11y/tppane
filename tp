            if gp then return end
            if not isManualMoveKey(input) then return end
            if not autoBackActive then return end
            if isThirdFloor then releaseFixed()
            else unequipAll(); destroyPlats() end
            setStatus("Manual move – released")
            autoBackActive = false
        end)

        local function ensureUnlock()
            unlockMovement()
            if manualMoveConn then manualMoveConn:Disconnect(); manualMoveConn = nil end
            autoBackActive = false
        end

        while autoBackActive do
            if player:GetAttribute("Stealing") then
                if isThirdFloor then releaseFixed()
                else unequipAll(); destroyPlats() end
                setStatus("Stealing – released")
                ensureUnlock(); return
            end
            if not isInsidePlotSquare(hrp.Position, plotName, squareSize) then
                if isThirdFloor then releaseFixed()
                else unequipAll(); destroyPlats() end
                setStatus("Left plot – aborted")
                ensureUnlock(); return
            end
            task.wait(0.1)
        end
        ensureUnlock()
