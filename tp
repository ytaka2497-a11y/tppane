        else
            track.BackgroundColor3 = tc
            knob.Position = kp
            knob.BackgroundColor3 = kc
        end
    end
    apply(false)
    return {
        Track=track,
        SetState=function(on) state=on; apply(true) end,
        GetState=function() return state end,
        ConnectClick=function(cb) track.MouseButton1Click:Connect(cb) end
    }
