            if input.UserInputType ~= Enum.UserInputType.Keyboard then return false end
            local k = input.KeyCode
            return k == Enum.KeyCode.W or k == Enum.KeyCode.A
                or k == Enum.KeyCode.S or k == Enum.KeyCode.D
                or k == Enum.KeyCode.Up or k == Enum.KeyCode.Down
                or k == Enum.KeyCode.Left or k == Enum.KeyCode.Right
                or k == Enum.KeyCode.Space
        end

