        Size=UDim2.new(0,13,0,13), Position=UDim2.new(0,2.5,0.5,-6.5),
        BackgroundColor3=Color3.fromRGB(199,195,219)
    }, track)
    corner(knob, 7)
    local state = def
    local function apply(anim)
        local kc = state and Color3.new(1,1,1) or Color3.fromRGB(199,195,219)
        local tc = state and Theme.AccentB or Theme.PanelField2
        local kp = state and UDim2.new(1,-15.5,0.5,-6.5) or UDim2.new(0,2.5,0.5,-6.5)
